<div id="container" class="container"> 
    <div class="card"> 
     <div id="card-content" class="card-content"> 
      <center>
       <% if (theme.logo) { %>
       <div class="logo"></div>
       <style>
        .logo {
	        width: 100px;
	        height: 100px;
	        margin-top: -50px;
	        border:2px solid rgba(255, 255, 255, 0.3);
	        background: url('<%= theme.logo %>') no-repeat center;
	        border-radius: 50px;
	        background-size: cover;
	        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }
       </style>
       <% } %>
      </center> 
      <% if (theme.nickname) { %>
      <b class="nickname"><%= theme.nickname %></b> 
      <br /> 
      <% } %>
      <% if (theme.motto) { %>
      <b class="motto"><%= theme.motto %></b> 
      <% } %>
      <p class="description">Добро пожаловать на мой сайт! Здесь вы найдете информацию о моих проектах, статьях и заметках. Исследую новые технологии, делюсь опытом и создаю интересные решения.</p>
      <% if (theme.social && typeof theme.social === 'object') { %>
      <div class="social">
        <% for (a in theme.social) { %> 
        <% if (theme.social[a] && Array.isArray(theme.social[a]) && theme.social[a].length >= 3) { %>
        <a href="<%= theme.social[a][0] %>" target="_blank"><button class="mdui-btn mdui-btn-icon" mdui-tooltip="{content: '<%= theme.social[a][1] %>'}"><span class="<%= theme.social[a][2] %>"></span></button></a> 
        <% } %>
       <% } %>
      </div> 
      <% } %>
     </div> 
    </div> 
   </div> 